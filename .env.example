# ── Servidor ─────────────────────────────────────────────────────────────────
PORT=3000
SITE_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# ── Autenticação Admin ───────────────────────────────────────────────────────
ADMIN_SECRET_KEY="SUA_CHAVE_SECRETA_DE_ADMIN"

# ── Firebase / Google Cloud ──────────────────────────────────────────────────
# Credencial de service account (JSON completo em uma linha, ou caminho do arquivo)
# usada para autenticar chamadas ao Firestore. Escopos: calendar, datastore.
GOOGLE_SERVICE_ACCOUNT_JSON=""
FIREBASE_WEB_API_KEY="SUA_FIREBASE_WEB_API_KEY"

# ── E-mail (Nodemailer) ──────────────────────────────────────────────────────
EMAIL_USER="seu-email@gmail.com"
EMAIL_PASS="sua-senha-de-app"

# ── GEMINI_API_KEY ───────────────────────────────────────────────────────────
# Necessária para o chat administrativo dos agentes (server.cjs /api/admin/chat/send).
GEMINI_API_KEY="SUA_CHAVE_API_DO_GEMINI"

# ── OPENROUTER_API_KEY ───────────────────────────────────────────────────────
# Habilita o Intent Prompt Agent (Citation Share real em 4 LLMs) e o Semantic
# Explorer Agent (análise de gaps de conteúdo via LLM real). Sem esta chave,
# ambos os agentes marcam dataSource: 'unavailable' — nunca simulam dado.
OPENROUTER_API_KEY="SUA_CHAVE_API_DO_OPENROUTER"

# ── GOOGLE_API_KEY (opcional) ────────────────────────────────────────────────
# Habilita o Google PageSpeed Insights API (Core Web Vitals reais no Technical
# Gatekeeper Agent). NÃO reutiliza o GOOGLE_SERVICE_ACCOUNT_JSON — é uma API
# key simples, gerada separadamente no Google Cloud Console. Sem esta chave,
# o campo coreWebVitals do Gatekeeper marca dataSource: 'unavailable'.
GOOGLE_API_KEY=""

# ── APIFY_API_TOKEN ──────────────────────────────────────────────────────────
# Usado pelo Lead Hunter para mineração de leads via Google Maps/Places Actor.
APIFY_API_TOKEN=""

# ── Puppeteer (opcional) ─────────────────────────────────────────────────────
# Caminho do executável do Chrome/Chromium, usado para capturar screenshots
# do relatório. Se ausente, o sistema tenta detectar automaticamente ou
# desabilita a captura de screenshots sem quebrar o restante do diagnóstico.
PUPPETEER_EXECUTABLE_PATH=""

# Portal Casa de Vídeo — somente no servidor (ver PLANO_IMPLANTACAO_DADOS_REAIS.md)
CDV_GA4_PROPERTY_ID=555545561
# CDV_GOOGLE_CREDENTIALS=/run/secrets/cdv-google-service-account.json
# CDV_GOOGLE_SERVICE_ACCOUNT_JSON=
# CDV_GSC_SITE_URL=sc-domain:casadevideo.com.br
# Credencial opcional exclusiva do Search Console; mantém a conta do GA4.
# CDV_GSC_CREDENTIALS=/run/secrets/cdv-gsc-service-account.json
# CDV_GSC_SERVICE_ACCOUNT_JSON=
# CDV_ADS_CUSTOMER_ID=
# CDV_ADS_DEVELOPER_TOKEN=
# CDV_ADS_CLIENT_ID=
# CDV_ADS_CLIENT_SECRET=
# CDV_ADS_REFRESH_TOKEN=
# CDV_ADS_LOGIN_CUSTOMER_ID=
CDV_ADS_API_VERSION=v23
# CDV_CRUX_API_KEY=
# CDV_DATA_DIR=/app/.runtime/cdv
# CDV_GEO_ROUNDS_FILE=/app/.runtime/cdv/rodadas_verificadas.json
